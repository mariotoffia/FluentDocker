<Project>
  <PropertyGroup>
    <!-- Single source of truth for NuGet package version. Bump here, commit, push -->
    <!-- master. CI reads this via `dotnet msbuild -getProperty:Version` and uses it -->
    <!-- for both `dotnet pack` and the git tag. No GitVersion, no override flags. -->
    <Version>3.2.0-preview.1</Version>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)keypair.snk</AssemblyOriginatorKeyFile>
    <PublicSign Condition=" '$(OS)' != 'Windows_NT' ">true</PublicSign>
    <Authors>Mario Toffia</Authors>
    <Copyright>&#169; 2016 - 2026 Mario Toffia</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/mariotoffia/FluentDocker</RepositoryUrl>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Suppress until nullable is fully enabled in main lib -->
    <NoWarn>$(NoWarn);CA1062</NoWarn>
    <!-- CA1507: all hits are [JsonProperty] serialization keys, not symbol refs — nameof is wrong here -->
    <NoWarn>$(NoWarn);CA1507</NoWarn>
    <!-- CA1848: logging is never on a hot path (each op brackets a process spawn / network I/O); LoggerMessage delegates not worth the boilerplate -->
    <NoWarn>$(NoWarn);CA1848</NoWarn>
    <!-- CA1859: advisory micro-perf (concrete-type devirtualization); all sites are cold paths (startup resolution, one-shot parse, test helpers) -->
    <NoWarn>$(NoWarn);CA1859</NoWarn>
    <!-- CA1720: 'Object' is the OpenAI API discriminator field ([JsonPropertyName("object")]), an external contract — like CA1507 above -->
    <NoWarn>$(NoWarn);CA1720</NoWarn>
    <!-- Culture/comparison analyzers promoted to errors so the cpus="1,5" locale bug class cannot regress -->
    <WarningsAsErrors>$(WarningsAsErrors);CA1304;CA1305;CA1310;CA1311</WarningsAsErrors>
  </PropertyGroup>
</Project>
